{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--isolated",
        "--viewport-size",
        "1280,800",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
